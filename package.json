{
  "name": "appointment-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "migrate:to-production": "ts-node --project scripts/tsconfig.json scripts/migrateToProduction.ts",
    "migrate:verify": "ts-node --project scripts/tsconfig.json scripts/migrateToProduction.ts verify",
    "migrate:quick": "./scripts/quick-migrate.sh",
    "deploy:vercel": "./scripts/deploy-vercel.sh",
    "deploy:vercel:prod": "./scripts/deploy-vercel.sh prod",
    "db:backup": "mongodump --uri=\"mongodb://localhost:27017/appointment-system\" --out=./database-backups/$(date +%Y%m%d_%H%M%S)",
    "db:restore": "mongorestore --uri=\"$MONGODB_URI\" --drop ./database-backups/latest",
    "redis:check": "ts-node --project scripts/tsconfig.json scripts/checkRedis.ts",
    "admin:create": "ts-node --project scripts/tsconfig.json scripts/createAdminUser.ts",
    "admin:verify": "ts-node --project scripts/tsconfig.json scripts/verifyAdminUser.ts",
    "db:test": "ts-node --project scripts/tsconfig.json scripts/testMongoConnection.ts",
    "git:check": "ts-node --project scripts/tsconfig.json scripts/checkGitIgnore.ts",
    "seed:enrollment": "tsx scripts/seedEnrollment.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:integration": "node --import tsx --test --test-concurrency=4 'tests/integration/**/*.test.ts'",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/nodemailer": "^8.0.1",
    "@types/plotly.js": "^3.0.8",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.554.0",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.16.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.0",
    "next": "^16.3.4",
    "nodemailer": "^10.0.8",
    "plotly.js-dist-min": "^3.3.0",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-calendar": "^6.0.0",
    "react-dom": "^19",
    "react-hook-form": "^7.66.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-plotly.js": "^2.6.0",
    "redis": "^5.9.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-plotly.js": "^2.6.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
