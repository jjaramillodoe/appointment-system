# Copy to .env.local for development (use a LOCAL database), or set these in Vercel for production.

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/appointment-system

# Auth: required in production (the app refuses to start without it). Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Public base URL used in email links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron authorization (production). Generate: openssl rand -hex 32
CRON_SECRET=

# Email (confirmations, password resets, reminders, waitlist offers).
# Leave SMTP_HOST empty to skip sending; reminders are then skipped too.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org

# Maps on the student dashboard (optional)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Redis cache / rate limiting (optional; set REDIS_ENABLED=false to turn off)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# Logging (optional): debug | info | warn | error
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1
